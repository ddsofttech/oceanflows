{
  "name": "@oceanflows/web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "knip": "knip",
    "jscpd": "jscpd src --threshold 3 --exitCode 1",
    "stylelint": "stylelint \"src/**/*.css\"",
    "check:placeholders": "tsx scripts/check-production-placeholders.ts",
    "audit:gate": "node scripts/npm-audit-gate.mjs"
  },
  "dependencies": {
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/cloudflare": "^12.6.13",
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.14.0",
    "jscpd": "^4.0.5",
    "knip": "^5.41.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "serve": "^14.2.4",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "tsx": "^4.19.2",
    "vitest": "^5.1.2",
    "wrangler": "^4.125.0"
  }
}
