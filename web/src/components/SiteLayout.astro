---
/**
 * @component SiteShell
 * @purpose Marketing site document shell with theme, styles, and scripts
 * @props title, description, skipTarget
 * @states default
 */
import "../styles/site.css";

interface Props {
  title: string;
  description?: string;
  skipTarget?: string;
}

const { title, description, skipTarget = "#home" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    <script is:inline src="/scripts/theme.js"></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="page">
    <a class="skip-link" href={skipTarget}>Skip to content</a>
    <slot name="header" />
    <slot />
    <slot name="footer" />
    <script is:inline src="/scripts/site.js"></script>
    <script is:inline src="/scripts/inquiry-static.js"></script>
  </body>
</html>
