---
/** Presentational theme toggle; behavior in /scripts/site.js */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  aria-label="Switch color theme"
>
  <span class="visually-hidden">Toggle color theme</span>
  <span class="theme-toggle__icon" aria-hidden="true"></span>
</button>