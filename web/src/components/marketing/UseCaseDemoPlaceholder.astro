---
/**
 * @component UseCaseDemoPlaceholder
 * @purpose Decorative abstract motion demo for non–Customer Support use cases (Q29)
 * @props variant
 * @states idle, active, reduced-motion-static
 * @story docs/tools-ticker-use-cases/prototype/stories/use-cases-default.html
 */
interface Props {
  variant: "sales" | "operations" | "automation";
}

const { variant } = Astro.props;

const badge =
  variant === "sales"
    ? "Lead scoring motif"
    : variant === "operations"
      ? "Knowledge lookup motif"
      : "Workflow handoff motif";
---

<div class={`use-case-demo use-case-demo--${variant}`} data-abstract>
  <span class="use-case-demo__badge">{badge}</span>
  {
    variant === "sales" && (
      <svg
        class="use-case-demo__svg"
        viewBox="0 0 280 200"
        width="280"
        height="200"
        aria-hidden="true"
      >
        <rect
          x="20"
          y="30"
          width="240"
          height="12"
          rx="4"
          fill="currentColor"
          opacity="0.12"
        />
        <rect
          class="use-case-demo__motion"
          x="20"
          y="58"
          width="160"
          height="10"
          rx="4"
          fill="currentColor"
          opacity="0.35"
        />
        <rect
          x="20"
          y="82"
          width="200"
          height="10"
          rx="4"
          fill="currentColor"
          opacity="0.12"
        />
        <circle
          class="use-case-demo__motion"
          cx="230"
          cy="140"
          r="28"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          opacity="0.5"
        />
        <path
          d="M40 150h80M40 170h120"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          opacity="0.35"
        />
      </svg>
    )
  }
  {
    variant === "operations" && (
      <svg
        class="use-case-demo__svg"
        viewBox="0 0 280 200"
        width="280"
        height="200"
        aria-hidden="true"
      >
        <rect
          x="24"
          y="24"
          width="232"
          height="152"
          rx="8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          opacity="0.2"
        />
        <rect
          class="use-case-demo__motion"
          x="40"
          y="48"
          width="120"
          height="8"
          rx="3"
          fill="currentColor"
          opacity="0.45"
        />
        <rect
          x="40"
          y="72"
          width="180"
          height="6"
          rx="2"
          fill="currentColor"
          opacity="0.12"
        />
        <rect
          x="40"
          y="88"
          width="150"
          height="6"
          rx="2"
          fill="currentColor"
          opacity="0.12"
        />
        <path
          class="use-case-demo__motion"
          d="M40 130h200"
          stroke="currentColor"
          stroke-width="2"
          stroke-dasharray="6 6"
          opacity="0.5"
        />
      </svg>
    )
  }
  {
    variant === "automation" && (
      <svg
        class="use-case-demo__svg"
        viewBox="0 0 280 200"
        width="280"
        height="200"
        aria-hidden="true"
      >
        <circle
          class="use-case-demo__motion"
          cx="70"
          cy="100"
          r="22"
          fill="currentColor"
          opacity="0.2"
        />
        <circle
          class="use-case-demo__motion"
          cx="140"
          cy="80"
          r="18"
          fill="currentColor"
          opacity="0.25"
        />
        <circle
          class="use-case-demo__motion"
          cx="210"
          cy="110"
          r="20"
          fill="currentColor"
          opacity="0.2"
        />
        <path
          d="M92 100h36M158 88h34"
          stroke="currentColor"
          stroke-width="2"
          opacity="0.35"
        />
      </svg>
    )
  }
</div>